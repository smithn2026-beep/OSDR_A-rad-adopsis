deg_csv_path = "C:/Users/smith/OneDrive - Florida Institute of Technology/summer 2026/OSDR/OSDR_A-rad-adopsis/unnormalized_results/Multifactor Analysis csv/DEG_unnorm_OSD658_GCR80_vs_none.csv",
label        = "OSD658_GCR80")
