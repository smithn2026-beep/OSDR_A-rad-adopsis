norm_file  = "DEG_OSD658_GCR80_vs_none.csv",
unnorm_file = file.path(output_dir, "DEG_unnorm_OSD658_GCR80_vs_none.csv")
)
)
comparison_pairs <- list(
list(
label      = "7a vs 5a: OSD498+510 radiation effect",
norm_file  = "DEG_OSD498_510_radiation_effect.csv",
unnorm_file = file.path(output_dir, "DEG_unnorm_OSD498_510_radiation_effect.csv")
),
list(
